{
  "name": "vault-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "description": "Headless RWA treasury autopilot for IXS vaults, driven by SERV Reasoning, with a model-configuration tournament and verifiable receipts.",
  "scripts": {
    "start": "node scripts/start.mjs",
    "dev": "node scripts/dev.mjs",
    "agent": "tsx --env-file=.env src/agent.ts",
    "epoch": "tsx --env-file=.env src/tournament.ts",
    "api": "tsx --env-file=.env src/api.ts",
    "ui": "pnpm --filter vault-pilot-ui dev",
    "wallet:new": "tsx scripts/wallet.ts new",
    "wallet:status": "tsx --env-file=.env scripts/wallet.ts status",
    "verify": "python3 scripts/verify.py --all",
    "verify:onchain": "python3 scripts/verify.py --all --rpc",
    "benchmark": "python3 scripts/benchmark.py",
    "build": "tsc -b",
    "build:ui": "pnpm --filter vault-pilot-ui build",
    "build:all": "pnpm build && pnpm build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "settle": "tsx --env-file=.env scripts/settle.ts"
  },
  "dependencies": {
    "@openserv-labs/sdk": "^2.4.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "viem": "^2.56.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
