{
  "name": "vault-pilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Headless RWA treasury autopilot for IXS vaults, driven by SERV Reasoning, with a model-configuration tournament and verifiable receipts.",
  "scripts": {
    "dev": "tsx --env-file=.env src/agent.ts",
    "epoch": "tsx --env-file=.env src/tournament.ts",
    "build": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "@openserv-labs/sdk": "^2.4.1",
    "dotenv": "^16.4.5",
    "js-yaml": "^4.1.0",
    "viem": "^2.56.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
