# ---------------------------------------------------------------------------
# Reasoning API (required)
# ---------------------------------------------------------------------------
# Key from console.openserv.ai/settings/keys.
# Data collection must be enabled at console.openserv.ai/settings/organization
# for hackathon eligibility.
SERV_API_KEY=

# OpenAI-compatible inference endpoint.
SERV_BASE_URL=https://inference-api.openserv.ai/v1

# Tournament arms: id:model:shadow:inPriceUSD:outPriceUSD, comma-separated.
# `shadow` (0|1) toggles the serv_shadow_agent validation loop for that arm.
# Prices are USD per million tokens and only affect cost reporting.
TOURNAMENT_MODELS=base-a:gpt-5.4-mini:0:1.00:6.00,shadow-a:gpt-5.4-mini:1:1.00:6.00,base-b:claude-haiku-4.5:0:1.25:6.50,base-c:gemini-3.5-flash:0:1.95:12.00

# serv_prompt_guard is enabled on every call because third-party vault
# metadata is interpolated into the prompt. Set to true only to measure the
# unguarded baseline.
DISABLE_PROMPT_GUARD=false

# ---------------------------------------------------------------------------
# Agent hosting (required to run the agent on the platform)
# ---------------------------------------------------------------------------
# Separate key from SERV_API_KEY. From platform.openserv.ai -> Developer ->
# Your Agents -> Create Secret Key.
OPENSERV_API_KEY=
# The hosted agent's own port. Distinct from API_PORT below, which is the
# site. Only the agent reads this one.
PORT=7378

# ---------------------------------------------------------------------------
# API / site binding
# ---------------------------------------------------------------------------
# Default is loopback (local only). For a public deploy set 0.0.0.0.
API_HOST=127.0.0.1
# Always set this explicitly. Left blank the API falls back to PORT — which a
# platform host injects (correct there) but which the agent also claims (wrong
# here), so an unset API_PORT next to PORT=7378 binds the site to 7378.
API_PORT=8787
# Only needed when the UI is hosted on a *different* origin than the API.
# When the API serves ui/dist itself (pnpm start), same-origin needs no value.
# UI_ORIGIN=https://your-domain.example

# Autonomous epoch cadence (seconds; floor 30). EPOCH_SCHEDULER=off stops it.
EPOCH_INTERVAL_SECONDS=3600
# EPOCH_SCHEDULER=on

# Required for the "run epoch" button in the UI. The scheduler runs
# regardless; without a token the button stays closed.
# OPERATOR_TOKEN=

# ---------------------------------------------------------------------------
# Outbound connections
# ---------------------------------------------------------------------------
# How long each candidate address gets to complete its TCP handshake before
# Node moves to the next one. Node's own default is 250ms, which a congested
# or high-latency link exceeds routinely — every outbound call then dies in
# half a second as "fetch failed" while the network is actually fine. Raise
# this if epochs fail with "no request reached"; lower it to fail over faster
# on a link you know is quick.
NET_CONNECT_ATTEMPT_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Live yield source
# ---------------------------------------------------------------------------
YIELD_SOURCE_BASE_URL=https://yields.llama.fi

# Notional treasury size — documentation/benchmark context only. Allocations
# are fractions of equity; no real capital is moved by the agent.
TREASURY_EQUITY_USD=1000000

# Path to the allocation policy.
# POLICY_PATH=src/config/policy.yaml

# ---------------------------------------------------------------------------
# Persistent state
# ---------------------------------------------------------------------------
# Signed receipts and the IXS share-price history are the evidence this system
# produces; both are written to disk. Relative paths are fine in a checkout. A
# hosted deploy must point these inside a mounted persistent disk, or every
# redeploy erases the tournament and it restarts from epoch 1.
# RECEIPTS_ROOT=receipts
# IXS_HISTORY_PATH=data/ixs-share-price-history.json

# ---------------------------------------------------------------------------
# Onchain receipt anchoring (optional; publishes each receipt hash onchain)
# ---------------------------------------------------------------------------
# Leave ANCHOR_PRIVATE_KEY unset to skip anchoring entirely.
# Supported chain ids: 84532 (Base Sepolia), 97 (BSC Testnet),
# 11155111 (Ethereum Sepolia), 421614 (Arbitrum Sepolia).
# Fund the address with testnet gas from the Finance District faucet.
ANCHOR_CHAIN_ID=84532
ANCHOR_PRIVATE_KEY=
# Override only if you need a different RPC provider for the chain above.
# ANCHOR_RPC_URL=

# ---------------------------------------------------------------------------
# Real IXS settlement (optional; manual only — the scheduler never settles)
# ---------------------------------------------------------------------------
# Set only to run `pnpm settle status|deposit|redeem` against the BNB Chain
# mainnet vault. This moves real funds; receipts are never affected.
# SETTLEMENT_PRIVATE_KEY=
# SETTLEMENT_MAX_PER_TX=10
