# ===========================================================================
# VAULT-PILOT — .gitignore
# Secrets first: never commit keys, funded-wallet material, or live .env.
# ===========================================================================

# --- Secrets & environment -------------------------------------------------
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa*
id_ed25519*
secrets.json
credentials.json
.wallet/
*.keystore

# --- Dependencies ----------------------------------------------------------
node_modules/
.pnpm-store/
.yarn/
.yarnrc.yml
# pnpm-lock.yaml is committed on purpose (reproducible installs)

# --- Build outputs ---------------------------------------------------------
dist/
build/
out/
ui/dist/
*.tsbuildinfo
tsconfig.tsbuildinfo
ui/tsconfig.tsbuildinfo
.vite/
.tsbuild/
*.d.ts.map

# --- Runtime state (regenerated by the agent; keep .gitkeep) ---------------
receipts/**/*.json
!receipts/.gitkeep
leaderboard.json
leaderboard.html
benchmark_results.json
epochs.log
epochs.pid
*.pid
nohup.out

# Local yield-observation cache writes here; committed copy may exist —
# ignore nothing under data/ by default so history stays reviewable.

# --- Python (verify.py / benchmark.py are stdlib-only; cache anyway) -------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Logs ------------------------------------------------------------------
*.log
logs/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Editors & IDEs --------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/
.cursor/
*.sublime-project
*.sublime-workspace

# --- OS junk ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Test & coverage artifacts --------------------------------------------
coverage/
htmlcov/
.nyc_output/
*.lcov

# --- Local overrides (never share) ----------------------------------------
ui/.env.local
ui/.env.*.local
*.local
!.env.example

# --- Misc temporary --------------------------------------------------------
*.tmp
*.temp
.cache/
.parcel-cache/
.netlify/
.vercel/
.firebase/
.surge/
